# Copiá este archivo a `.env.local` y completá los valores.
#
# `.env.local` está en `.gitignore` y nunca se commitea. Ojo: todo lo que
# empieza con `VITE_` termina en el bundle que se descarga el navegador, así
# que acá NO va ningún secreto. El identificador de cliente de OAuth es
# público por diseño; el `client_secret` no se usa en este proyecto.

# Identificador de cliente OAuth 2.0, de Google Cloud Console.
# Tiene la forma 000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Debe coincidir con VOCAIA_OIDC_AUDIENCIA del backend: es el valor que este
# verifica en el reclamo `aud` del token.
VITE_GOOGLE_CLIENT_ID=

# URL del backend. En desarrollo, lo que levanta `uvicorn`.
VITE_API_URL=http://localhost:8000
